{
  "name": "advent-code",
  "version": "0.1.0",
  "private": true,
  "description": "Calendrier de l'Avent du code : web, terminal, mail.",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:expert": "python3 scripts/expert/verifier.py",
    "build": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && node scripts/serve.mjs",
    "check": "node scripts/validate.mjs && node scripts/build-content.mjs"
  }
}
